FC = gfortran
CC = gcc
FFLAGS = -std=f2008 -O2 -Wall -Wextra -Werror -fcheck=all -fbacktrace -ffree-line-length-none
CFLAGS = -std=c11 -O2 -Wall -Wextra -Werror -fstack-protector-strong -D_FORTIFY_SOURCE=2
LDFLAGS = -llapack -lblas -lcrypto
all: build/void_loop
build/void_loop: src/void_native.f90 src/hx89_exec.c src/cpu_feedback.c
	mkdir -p build
	$(CC) $(CFLAGS) -c src/hx89_exec.c -o build/hx89_exec.o
	$(CC) $(CFLAGS) -c src/cpu_feedback.c -o build/cpu_feedback.o
	$(CC) $(CFLAGS) -c src/cpu_cycle.c -o build/cpu_cycle.o
	$(FC) $(FFLAGS) -J build src/void_native.f90 build/hx89_exec.o build/cpu_feedback.o -o $@ $(LDFLAGS)
clean:
	rm -f build/void_loop build/hx89_exec.o build/cpu_feedback.o build/*.mod
.PHONY: all clean

build/native_driver_contract: tests/native_driver_contract.c src/hx89_exec.c src/cpu_feedback.c
	$(CC) $(CFLAGS) tests/native_driver_contract.c src/hx89_exec.c src/cpu_feedback.c -o $@ -lcrypto
